---
import { paintColors } from "../design/tokens";
const passes = [
  {
    name: "Daydream",
    theme: "yellow",
    caption: "A little room to bloom.",
    serial: "FLW–001",
  },
  {
    name: "High score",
    theme: "cream",
    caption: "Made for your next level.",
    serial: "PLY–002",
  },
  {
    name: "After hours",
    theme: "green",
    caption: "For the beautifully curious.",
    serial: "NXT–003",
  },
];
---

<section id="play" class="pass-studio wrap" aria-labelledby="pass-heading">
  <div class="section-marker mono">03 / YOUR PASS. YOUR PIXELS.</div>
  <div class="pass-intro">
    <h2 id="pass-heading">
      Make your mark.
      <br />
      Take it with you.
    </h2>
    <div>
      <p>
        Three little keepsakes. Zero boring pixels.
        <br />
        Pick your pass, paint your pixels, make it yours.
      </p>
      <span class="mono">ALL ACCESS. ALL YOURS. NO COINS REQUIRED.</span>
    </div>
  </div>
  <div class="pass-stage">
    {passes.map((pass, index) => (
      <article
        class={`collectible ${pass.theme}`}
        data-pass={index}
        data-active="false"
        tabindex="0"
        aria-describedby="pass-edit-help"
        aria-label={`${pass.name} pass`}
      >
        <span class="selection-badge mono">✓</span>
        <div class="pass-paper">
          <div class="pass-top">
            <img
              src="/images/vega-logo.svg"
              alt="Vega"
              width="62"
              height="21"
            />
            <span class="mono">
              ADMIT ONE
              <br />
              ALL ACCESS
            </span>
          </div>
          <div class="pass-title">
            <h3>16-Bit Con</h3>
            <span class="mono">
              3–5 OCT
              <br />
              2026
            </span>
          </div>
          <div class="pass-art">
            <div
              class="pass-grid"
              role="grid"
              aria-label={`${pass.name} pixel canvas`}
              data-grid={index}
            >
              {Array.from({ length: 16 }, (_, r) => (
                <div role="row">
                  {Array.from({ length: 16 }, (_, c) => (
                    <button
                      type="button"
                      role="gridcell"
                      tabindex={-1}
                      disabled
                      data-pixel={r * 16 + c}
                      aria-label={`Row ${r + 1}, column ${c + 1}, blank`}
                    ></button>
                  ))}
                </div>
              ))}
            </div>
          </div>
          <div class="pass-edition">
            <h4>{pass.name}</h4>
            <p>{pass.caption}</p>
          </div>
          <div class="pass-tear" aria-hidden="true"></div>
          <button
            class="pass-stub"
            type="button"
            data-confirm={index}
            aria-label={`Confirm ${pass.name} and create my souvenir pass`}
          >
            <span>
              <span class="mono">{pass.serial} / ALL ACCESS</span>
              <span class="pass-barcode" aria-hidden="true"></span>
              <span class="mono">JAVITS CENTER, NY / 3–5 OCT</span>
            </span>
            <span class="stub-action">
              <strong>
                Make this
                <br />
                my pass
              </strong>
            </span>
          </button>
        </div>
      </article>
    ))}
  </div>
  <div
    class="pass-tools"
    id="pass-tools"
    aria-label="Customize your pass"
    hidden
  >
    <div class="swatches" role="group" aria-label="Paint color">
      {paintColors.map((s, i) => (
        <button
          type="button"
          class="swatch"
          data-color={s.c}
          aria-label={s.n}
          title={s.n}
          aria-pressed={i === 0 ? "true" : "false"}
          style={`--swatch:${s.c || "transparent"}`}
        >
          {!s.c && (
            <svg
              viewBox="0 0 24 24"
              width="19"
              height="19"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true"
            >
              <path d="m4 14 9-10 7 7-9 10H7l-3-3v-4Zm4-4 7 7M10 21h11" />
            </svg>
          )}
        </button>
      ))}
    </div>
    <div class="pass-tool-actions">
      <button
        type="button"
        id="deselect-pass"
        aria-label="Deselect ticket"
        title="Done editing (Escape)"
      >
        <svg viewBox="0 0 24 24">
          <path d="m6 6 12 12M18 6 6 18" />
        </svg>
      </button>
      <button type="button" id="undo-art" aria-label="Undo stroke" title="Undo">
        <svg viewBox="0 0 24 24">
          <path d="M9 5 4 10l5 5M4 10h10a6 6 0 0 1 0 12" />
        </svg>
      </button>
      <button
        type="button"
        id="reset-art"
        aria-label="Restore original artwork"
        title="Reset"
      >
        <svg viewBox="0 0 24 24">
          <path d="M4 4v6h6M4 10a8 8 0 1 1 0 6" />
        </svg>
      </button>
      <button
        type="button"
        id="clear-art"
        aria-label="Clear artwork"
        title="Clear"
      >
        <svg viewBox="0 0 24 24">
          <path d="M4 6h16M9 6V3h6v3M6 6l1 15h10l1-15M10 10v7m4-7v7" />
        </svg>
      </button>
    </div>
  </div>
  <span id="paint-status" class="edit-sr-only" role="status">
    Click a ticket to edit.
  </span>
  <span id="pass-edit-help" class="edit-sr-only">
    Click or press Enter to select a ticket. Pick a color in the floating
    toolbar. Hover to preview, click or drag to paint. Use arrow keys and Space
    on the canvas. Press Escape, use Done editing, or click outside to deselect.
  </span>
  <p class="pass-disclaimer">
    A fictional event. A real keepsake. Download your personalized souvenir
    pass.
  </p>
</section>
<script is:inline type="importmap">
  { "imports": { "pass-three": "/pass-vendor/three.module.js" } }
</script>
<script>
  import "../scripts/pass-studio";
</script>
<style>
  .pass-studio {
    position: relative;
    padding-top: var(--space-20);
    padding-bottom: 65px;
    overflow: clip;
  }
  .pass-anchor {
    position: absolute;
    top: 0;
  }
  .pass-intro {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 35px;
  }
  .pass-intro h2 {
    font-size: clamp(52px, 5.5vw, 80px);
  }
  .pass-intro p {
    font-size: var(--text-base);
    margin-bottom: var(--space-5);
  }
  .pass-intro .mono {
    font-size: var(--text-xs);
  }
  .pass-stage {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 34px;
    perspective: 1400px;
    padding: 76px var(--space-4) 66px;
    align-items: start;
  }
  .collectible {
    --paper: var(--color-accent);
    --foreground: var(--color-text);
    --turn: -5deg;
    --drop: 16px;
    position: relative;
    color: var(--foreground);
    transform: translateY(var(--drop)) rotate(var(--turn))
      rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform var(--motion-base) ease,
      filter var(--motion-base);
    filter: drop-shadow(
      5px 8px 0 color-mix(in srgb, var(--color-text) 18.82%, transparent)
    );
    will-change: transform;
  }
  .collectible.cream {
    --paper: var(--color-ticket-score);
    --turn: 1deg;
    --drop: -12px;
  }
  .collectible.green {
    --paper: var(--color-heading);
    --foreground: var(--color-surface);
    --turn: 5deg;
    --drop: 22px;
  }
  .collectible:hover {
    z-index: 2;
    transform: translateY(-18px) translateZ(48px) rotateX(var(--rx, 0deg))
      rotateY(var(--ry, 0deg));
    filter: drop-shadow(
      8px 16px 0 color-mix(in srgb, var(--color-text) 14.51%, transparent)
    );
  }
  .collectible:focus-within,
  .collectible[data-drawing="true"] {
    z-index: 3;
    transform: translateY(-18px);
  }
  .pass-paper {
    padding: 25px 25px 23px;
    background: var(--paper);
    position: relative;
    clip-path: polygon(
      0 12px,
      12px 12px,
      12px 0,
      calc(100% - 12px) 0,
      calc(100% - 12px) 12px,
      100% 12px,
      100% calc(100% - 12px),
      calc(100% - 12px) calc(100% - 12px),
      calc(100% - 12px) 100%,
      12px 100%,
      12px calc(100% - 12px),
      0 calc(100% - 12px)
    );
    mask:
      linear-gradient(var(--color-text) 0 0) center/calc(100% - 12px)
        calc(100% - 12px) no-repeat,
      repeating-linear-gradient(
          0deg,
          var(--color-text) 0 10px,
          transparent 10px 18px
        )
        center/100% calc(100% - 24px) no-repeat,
      repeating-linear-gradient(
          90deg,
          var(--color-text) 0 10px,
          transparent 10px 18px
        )
        center/calc(100% - 24px) 100% no-repeat;
  }
  .cream .pass-paper {
    padding-top: 33px;
  }
  .cream .pass-top:before {
    content: "";
    position: absolute;
    top: 12px;
    left: calc(50% - 23px);
    width: 46px;
    height: 6px;
    background: var(--color-surface);
  }
  .green .pass-paper {
    clip-path: polygon(
      0 24px,
      12px 24px,
      12px 12px,
      24px 12px,
      24px 0,
      calc(100% - 24px) 0,
      calc(100% - 24px) 12px,
      calc(100% - 12px) 12px,
      calc(100% - 12px) 24px,
      100% 24px,
      100% calc(100% - 24px),
      calc(100% - 12px) calc(100% - 24px),
      calc(100% - 12px) calc(100% - 12px),
      calc(100% - 24px) calc(100% - 12px),
      calc(100% - 24px) 100%,
      24px 100%,
      24px calc(100% - 12px),
      12px calc(100% - 12px),
      12px calc(100% - 24px),
      0 calc(100% - 24px)
    );
  }
  .pass-top,
  .pass-title,
  .pass-stub {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }
  .pass-top {
    margin-bottom: 22px;
  }
  .pass-top .mono {
    text-align: right;
    font-size: 8px;
    line-height: 1.6;
  }
  .green img {
    filter: brightness(0) invert(1);
  }
  .pass-title h3 {
    font-family: var(--font-display);
    font-size: clamp(30px, 3.3vw, 49px);
    letter-spacing: -0.04em;
  }
  .pass-title > .mono {
    font-size: 8px;
    line-height: 1.5;
  }
  .pass-art {
    margin-top: 17px;
  }
  .pass-grid {
    width: 100%;
    aspect-ratio: 1;
    display: grid;
    grid-template-rows: repeat(16, 1fr);
    touch-action: none;
    user-select: none;
    background: color-mix(in srgb, var(--paper), var(--color-surface) 18%);
  }
  .pass-grid > [role="row"] {
    display: grid;
    grid-template-columns: repeat(16, 1fr);
    min-height: 0;
  }
  .pass-grid button {
    padding: 0;
    min-width: 0;
    min-height: 0;
    border: 0;
    background: transparent;
    box-shadow: inset -1px -1px
      color-mix(in srgb, var(--color-text) 4.71%, transparent);
  }
  .pass-grid button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -2px;
    z-index: 1;
  }
  .art-invitation {
    display: block;
    text-align: center;
    margin-top: 10px;
    font-size: 8px;
  }
  .pass-edition {
    margin-top: var(--space-5);
  }
  .pass-edition h4 {
    font: 32px/1 var(--font-display);
    margin: 0 0 7px;
  }
  .pass-edition p {
    font-size: var(--text-xs);
  }
  .pass-tear {
    margin: 22px -25px 18px;
    border-top: 2px dashed currentColor;
    opacity: 0.5;
    position: relative;
  }
  .pass-tear:before,
  .pass-tear:after {
    content: "";
    position: absolute;
    top: -9px;
    background: var(--color-surface);
    width: 13px;
    height: 16px;
  }
  .pass-tear:after {
    right: 0;
  }
  .pass-stub .mono {
    font-size: 7px;
  }
  .pass-barcode {
    height: 22px;
    width: 110px;
    margin: var(--space-2) 0 5px;
    background: repeating-linear-gradient(
      90deg,
      currentColor 0 2px,
      transparent 2px 4px,
      currentColor 4px 5px,
      transparent 5px 8px,
      currentColor 8px 12px,
      transparent 12px 15px
    );
  }
  .select-pass {
    padding: 10px 9px;
    border: 1px solid currentColor;
    background: transparent;
    font-size: var(--text-xs);
    display: flex;
    gap: 10px;
  }
  .select-pass[aria-pressed="true"] {
    background: var(--foreground);
    color: var(--paper);
  }
  .pass-tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    border-block: 1px solid var(--color-border);
    padding: 22px 0;
  }
  .tool-heading {
    display: grid;
    gap: 7px;
  }
  .tool-heading .mono {
    font-size: 8px;
  }
  .tool-heading strong {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 400;
  }
  .pass-tool-actions {
    display: flex;
    gap: 18px;
  }
  .pass-tools .swatch {
    width: 30px;
    height: 30px;
  }
  .pass-tools .button {
    white-space: nowrap;
  }
  .pass-instructions {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    margin-top: 17px;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .pass-disclaimer {
    margin-top: 30px;
    text-align: center;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  @media (max-width: 1000px) {
    .pass-stage {
      gap: 17px;
      padding-inline: 0;
    }
    .pass-paper {
      padding-inline: 19px;
    }
    .pass-tear {
      margin-inline: -19px;
    }
    .pass-tools {
      flex-wrap: wrap;
    }
    .pass-title h3 {
      font-size: 34px;
    }
    .pass-stub {
      align-items: start;
      flex-direction: column;
    }
    .pass-stub > div {
      width: 100%;
    }
    .pass-barcode {
      width: 100%;
    }
    .select-pass {
      width: 100%;
      justify-content: space-between;
    }
  }
  @media (max-width: 650px) {
    .pass-studio {
      padding-top: 45px;
    }
    .pass-intro {
      display: block;
    }
    .pass-intro > div {
      margin-top: var(--space-6);
    }
    .pass-stage {
      grid-template-columns: 1fr;
      gap: 38px;
      padding: 45px var(--space-3);
      max-width: 380px;
      margin: auto;
    }
    .collectible,
    .collectible.cream,
    .collectible.green {
      --drop: 0px;
      --turn: -2deg;
    }
    .collectible.cream {
      --turn: 2deg;
    }
    .collectible.green {
      --turn: -1deg;
    }
    .pass-paper {
      padding-inline: 28px;
    }
    .pass-title h3 {
      font-size: 48px;
    }
    .pass-stub {
      flex-direction: row;
      align-items: center;
    }
    .pass-stub > div {
      width: auto;
    }
    .pass-barcode {
      width: 110px;
    }
    .select-pass {
      width: auto;
    }
    .pass-tear {
      margin-inline: -28px;
    }
    .pass-tools {
      gap: 22px;
    }
    .tool-heading {
      width: 100%;
    }
    .pass-tools > .button {
      width: 100%;
      justify-content: space-between;
    }
    .pass-instructions {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .collectible,
    .collectible:hover,
    .collectible:focus-within {
      transition: none;
      transform: none;
      will-change: auto;
    }
  }

  .pass-stage {
    position: relative;
    isolation: isolate;
  }
  .pass-aura {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
    image-rendering: pixelated;
  }
  .selection-badge {
    position: absolute;
    left: 0;
    right: 0;
    top: -30px;
    text-align: center;
    color: var(--color-text);
    font-size: var(--text-xs);
    visibility: hidden;
  }
  .collectible[data-active="true"],
  .collectible[data-active="true"]:hover {
    transform: translateY(-18px);
    z-index: 3;
    filter: drop-shadow(
      7px 10px 0 color-mix(in srgb, var(--color-text) 25.1%, transparent)
    );
  }
  .collectible[data-active="true"] .selection-badge {
    visibility: visible;
  }
  .pass-art {
    position: relative;
  }
  .art-select {
    position: absolute;
    z-index: 2;
    left: 12px;
    right: 12px;
    bottom: 35px;
    border: 1px solid var(--color-text);
    background: var(--color-surface);
    color: var(--color-text);
    padding: 13px var(--space-2);
    box-shadow: 4px 4px 0 var(--color-text);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .art-select > span {
    font-size: 19px;
    margin-right: 5px;
  }
  .art-select small {
    display: block;
    font-size: var(--text-xs);
    font-weight: 400;
    margin-top: 5px;
  }
  .collectible[data-active="true"] .art-select {
    display: none;
  }
  .collectible[data-active="false"] .pass-grid {
    pointer-events: none;
  }
  .collectible[data-active="true"] .pass-grid {
    outline: 2px solid var(--foreground);
    outline-offset: 3px;
    cursor: crosshair;
  }
  .pass-grid button {
    cursor: crosshair;
  }
  .pass-tools[hidden] {
    display: none;
  }
  .pass-tools {
    flex-wrap: wrap;
    gap: 14px;
    padding: var(--space-4) 0 var(--space-3);
    border-color: currentColor;
    margin-top: var(--space-4);
  }
  .tool-heading {
    width: 100%;
    gap: var(--space-1);
  }
  .tool-heading strong {
    font-size: 23px;
  }
  .pass-tools .swatches {
    gap: 9px;
    flex-wrap: wrap;
  }
  .pass-tools .swatch {
    width: 29px;
    height: 29px;
    color: var(--color-text);
    background-color: var(--swatch);
    border-color: var(--foreground);
  }
  .pass-tools .swatch[aria-pressed="true"] {
    outline-color: var(--foreground);
  }
  .pass-tool-actions {
    width: 100%;
    justify-content: space-between;
  }
  .pass-tool-actions button {
    font-size: var(--text-xs);
    padding: 7px;
  }
  .editor-help {
    font-size: var(--text-xs);
    line-height: 1.6;
    width: 100%;
  }
  .pass-stub {
    position: relative;
    width: calc(100% + 50px);
    margin: 0 -25px -23px;
    padding: var(--space-5) 25px 26px;
    border: 0;
    text-align: left;
    color: inherit;
    background: color-mix(in srgb, var(--paper), var(--foreground) 8%);
    transform-origin: top;
    transition: background var(--motion-press);
  }
  .pass-stub:disabled {
    opacity: 0.58;
  }
  .pass-stub:not(:disabled):hover {
    background: color-mix(in srgb, var(--paper), var(--foreground) 17%);
  }
  .pass-stub:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: -7px;
  }
  .pass-barcode {
    display: block;
  }
  .stub-action strong {
    display: block;
    font: 27px/0.95 var(--font-display);
  }
  .stub-hint {
    display: block;
    font-size: var(--text-xs);
    margin-top: 9px;
  }
  .peel-corner {
    position: absolute;
    right: 7px;
    bottom: 7px;
    font-size: var(--text-lg);
  }
  .pass-tear {
    margin-bottom: 0;
  }
  .collectible[data-detached="true"] .pass-stub {
    visibility: hidden;
  }
  @media (max-width: 1000px) {
    .pass-stub {
      width: calc(100% + 38px);
      margin-inline: -19px;
      padding-inline: 19px;
      flex-direction: row;
      flex-wrap: wrap;
    }
    .pass-stub .pass-barcode {
      width: 90px;
    }
  }
  @media (max-width: 650px) {
    .pass-stub {
      width: calc(100% + 56px);
      margin-inline: -28px;
      padding-inline: 28px;
    }
    .pass-stage {
      gap: 68px;
    }
    .pass-tools {
      gap: 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .collectible[data-active="true"],
    .collectible[data-active="true"]:hover {
      transform: none;
    }
  }

  .collectible {
    cursor: pointer;
  }
  .collectible:focus-visible {
    outline: 2px dashed var(--color-heading);
    outline-offset: 12px;
  }
  .selection-badge {
    left: auto;
    right: 7px;
    top: -29px;
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    background: var(--color-text);
    color: var(--color-surface);
    font-size: var(--text-base);
  }
  .pass-tools {
    position: fixed;
    z-index: 30;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%);
    width: max-content;
    max-width: calc(100vw - 24px);
    flex-wrap: nowrap;
    gap: 17px;
    padding: 14px 18px;
    margin: 0;
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-text);
    box-shadow: 5px 5px 0
      color-mix(in srgb, var(--color-text) 20.78%, transparent);
  }
  .pass-tools[data-onscreen="false"] {
    visibility: hidden;
