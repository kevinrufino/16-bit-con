---
/**
 * First-paint curtain. Holds the page until fonts, the hero queue, and the
 * window load event settle, so the site never shows half-drawn type or an
 * empty stage where the mole crowd belongs.
 */
---

<div id="site-loader" role="status" aria-live="polite">
  <div class="loader-inner">
    <span class="loader-kicker mono">Vega presents</span>
    <p class="loader-title">16-Bit Con</p>
    <div class="loader-bar" aria-hidden="true">
      {Array.from({ length: 16 }, (_, i) => (
        <i style={`--i:${i}`}></i>
      ))}
    </div>
    <p class="loader-note mono">Loading the pixels…</p>
  </div>
</div>
<noscript>
  <style>
    #site-loader {
      display: none !important;
    }
  </style>
</noscript>

<style is:inline>
  html[data-loading] {
    overflow: hidden;
  }
  html[data-loading] body {
    overflow: hidden;
  }
  #site-loader {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: grid;
    place-items: center;
    background: var(--color-surface, #fffaeb);
    transition: opacity 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  #site-loader[data-done] {
    opacity: 0;
    pointer-events: none;
  }
  html:not([data-loading]) #site-loader {
    display: none;
  }
  .loader-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 0 24px;
    text-align: center;
  }
  .loader-kicker {
    font: 10px/1 var(--font-mono, monospace);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted, #3c3b38);
  }
  .loader-title {
    margin: 0;
    font: clamp(52px, 11vw, 104px) / 0.95 var(--font-display, Georgia, serif);
    letter-spacing: -0.06em;
    color: var(--color-heading, #0d5500);
  }
  .loader-bar {
    display: flex;
    gap: 3px;
    margin-top: 4px;
    padding: 4px;
    border: 1px solid var(--color-border-strong, #0d5500);
    box-shadow: 3px 3px 0 var(--color-heading, #0d5500);
  }
  .loader-bar i {
    width: 10px;
    height: 14px;
    background: var(--color-border, #cdd0bb);
  }
  .loader-bar i.on {
    background: var(--color-heading, #0d5500);
  }
  .loader-bar i.on:nth-child(even) {
    background: var(--color-accent, #ffd11b);
  }
  .loader-note {
    font: 10px/1 var(--font-mono, monospace);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-heading, #0d5500);
  }
  @media (max-width: 480px) {
    .loader-bar i {
      width: 7px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #site-loader {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    root.dataset.loading = "";
    const MIN_VISIBLE = 520;
    const MAX_WAIT = 6000;
    const started = performance.now();
    let progress = 0;
    let blocks = [];
    let creep = 0;
    let finished = false;

    // Three real milestones plus a slow creep so the bar never sits still.
    const bump = (amount) => {
      progress = Math.min(0.97, progress + amount);
      paint();
    };
    function paint() {
      if (!blocks.length) return;
      const filled = Math.round(progress * blocks.length);
      blocks.forEach((block, i) => block.classList.toggle("on", i < filled));
    }

    function finish() {
      if (finished) return;
      finished = true;
      clearInterval(creep);
      progress = 1;
      paint();
      const wait = Math.max(0, MIN_VISIBLE - (performance.now() - started));
      setTimeout(() => {
        const loader = document.getElementById("site-loader");
        if (!loader) {
          root.removeAttribute("data-loading");
          return;
        }
        loader.dataset.done = "";
        const clear = () => {
          root.removeAttribute("data-loading");
          loader.remove();
          window.dispatchEvent(new Event("site-loaded"));
        };
        loader.addEventListener("transitionend", clear, { once: true });
        setTimeout(clear, 600);
      }, wait);
    }

    function start() {
      const loader = document.getElementById("site-loader");
      if (!loader) return finish();
      blocks = [...loader.querySelectorAll(".loader-bar i")];
      creep = setInterval(() => bump(0.01), 160);
      paint();

      const steps = [];
      steps.push(document.fonts.ready.then(() => bump(0.3)));

      // The hero queue is the heaviest thing on the page: wait for it to report
      // ready, or for its fallback art to take over, before lifting the curtain.
      const world = document.getElementById("con-world");
      if (world) {
        steps.push(
          new Promise((resolve) => {
            const done = () => {
              bump(0.3);
              resolve();
            };
            if (world.dataset.loaded) return done();
            const observer = new MutationObserver(() => {
              const fallback = document.getElementById("con-fallback");
              if (world.dataset.loaded || (fallback && !fallback.hidden)) {
                observer.disconnect();
                done();
              }
            });
            observer.observe(world, {
              attributes: true,
              subtree: true,
              attributeFilter: ["data-loaded", "hidden"],
            });
            setTimeout(() => {
              observer.disconnect();
              done();
            }, MAX_WAIT);
          }),
        );
      }

      steps.push(
        document.readyState === "complete"
          ? Promise.resolve(bump(0.25))
          : new Promise((resolve) =>
              window.addEventListener(
                "load",
                () => {
                  bump(0.25);
                  resolve();
                },
                { once: true },
              ),
            ),
      );

      Promise.all(steps).then(finish);
      setTimeout(finish, MAX_WAIT);
    }

    if (document.readyState === "loading")
      document.addEventListener("DOMContentLoaded", start, { once: true });
    else start();
  })();
</script>
