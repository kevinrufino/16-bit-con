---
const locals = [
  { id: "classic", name: "Pico", detail: "Say hello", color: "#00b8cd" },
  { id: "propeller", name: "Dot", detail: "Make some noise", color: "#ed6950" },
  { id: "superfan", name: "Patch", detail: "Find a friend", color: "#238260" },
  {
    id: "gamer",
    name: "Byte",
    detail: "Beat the high score",
    color: "#9166ba",
  },
  { id: "artist", name: "Pip", detail: "Wake up gently", color: "#d99e29" },
  { id: "crew", name: "Chip", detail: "Ask for directions", color: "#6696c7" },
];
---

<section class="con-hero" aria-labelledby="event-name">
  <div class="con-heading wrap">
    <div class="con-heading-top">
      <span>
        <i></i> A celebration of pixels.
      </span>
      <span>
        Brooklyn, NY <b>↗</b> October 24, 2026
      </span>
    </div>
    <h1 id="event-name">
      16-Bit Con
      <span aria-hidden="true" class="con-spark">
        ✳
      </span>
    </h1>
    <div class="con-intro">
      <p>
        Good pixels. Great company.
        <br />A whole little world to get lost in.
      </p>
      <a href="/#register" class="button">
        Find your people <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
  <div class="con-world-wrap wrap">
    <div
      id="con-world"
      class="con-world"
      aria-label="Interactive pixel convention. Meet a mole using the buttons below, or tap a character. Tap the floor to send your selected mole there."
    >
      <div class="con-world-label">
        <span class="con-live-dot"></span> The doors are already open.
      </div>
      <img
        id="con-fallback"
        class="con-fallback"
        src="/drafts/convention-hero/lineup.png"
        alt="Six colorful mole characters ready to meet you at 16-Bit Con"
        width="1800"
        height="760"
      />
      <div id="con-tooltip" class="con-tooltip" aria-hidden="true" hidden></div>
      <div id="con-bubbles" class="con-bubbles" aria-hidden="true"></div>
      <div class="con-world-note" id="con-world-note">
        A tiny convention is loading…
      </div>
      <button
        id="con-motion"
        class="con-motion"
        type="button"
        aria-pressed="false"
        aria-label="Pause scene motion"
        disabled
      >
        <span aria-hidden="true">Ⅱ</span> Pause
      </button>
    </div>
    <div class="con-controls">
      <div class="con-invitation">
        <span class="con-pointer" aria-hidden="true">
          ↖
        </span>
        <div>
          <strong>Go on. Break the ice.</strong>
          <p id="con-response" role="status" aria-live="polite">
            Tap a mole to say hello. Tap the floor to wander.
          </p>
        </div>
      </div>
      <button type="button" class="con-party" id="con-party" disabled>
        <span aria-hidden="true">✦</span> Start a pixel party{" "}
        <span aria-hidden="true">↗</span>
      </button>
    </div>
    <div class="con-locals" role="group" aria-label="Meet the moles">
      {locals.map((local) => (
        <button
          disabled
          type="button"
          data-meet={local.id}
          class="con-local"
          style={`--local-color:${local.color}`}
          aria-label={`${local.name}: ${local.detail}`}
          aria-pressed="false"
        >
          <span class="local-dot" aria-hidden="true"></span>
          <span>{local.name}</span>
          <span class="local-check" aria-hidden="true">
            +
          </span>
        </button>
      ))}
      <span id="con-progress" class="con-progress">
        0 / 6 friends met
      </span>
    </div>
    <div class="con-bottom">
      <span>Talks worth talking about.</span>
      <span>Worlds worth building.</span>
      <span>People worth meeting.</span>
      <a href="/#about">
        Get to know the con <span aria-hidden="true">↓</span>
      </a>
    </div>
  </div>
</section>
<script is:inline type="importmap">
  { "imports": { "three": "/drafts/convention-hero/vendor/three.module.js" } }
</script>
<script is:inline type="module" src="/drafts/convention-hero/convention-header.js"></script>
<style>
  .con-hero {
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 24px;
  }
  .con-heading-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    padding: 20px 0 10px;
    border-top: 1px solid var(--rule);
  }
  .con-heading-top > span:first-child {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .con-heading-top i {
    width: 7px;
    height: 7px;
    background: var(--green);
    display: block;
  }
  .con-heading-top b {
    font-size: 16px;
    margin: 0 12px;
    font-weight: 400;
  }
  .con-heading h1 {
    position: relative;
    font-family: var(--display);
    font-size: clamp(110px, 17.7vw, 248px);
    line-height: 0.95;
    letter-spacing: -0.06em;
    color: var(--green);
    margin: 14px 0 4px;
    white-space: nowrap;
  }
  .con-spark {
    font-family: var(--mono);
    font-size: 0.4em;
    display: inline-block;
    vertical-align: middle;
    margin-left: 0.25em;
    transform: rotate(-8deg);
    color: var(--green);
  }
  .con-intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 2px;
  }
  .con-intro p {
    font-size: 15px;
    line-height: 1.5;
    max-width: 350px;
  }
  .con-intro .button {
    font-size: 13px;
    min-height: 44px;
    padding: 12px 20px;
  }
  .con-world {
    position: relative;
    height: 460px;
    margin-top: 10px;
    isolation: isolate;
    touch-action: pan-y;
  }
  .con-world :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    touch-action: pan-y;
  }
  .con-fallback {
    position: absolute;
    inset: 10% 0;
    width: 100%;
    height: 80%;
    object-fit: contain;
    image-rendering: pixelated;
    mix-blend-mode: multiply;
  }
  .con-fallback[hidden] {
    display: none;
  }
  .con-world-label {
    position: absolute;
    left: 0;
    top: 25px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--green);
    pointer-events: none;
  }
  .con-live-dot {
    width: 5px;
    height: 5px;
    background: var(--green);
    box-shadow: 0 0 0 3px #0d550014;
  }
  .con-world-note {
    position: absolute;
    bottom: 12px;
    left: 0;
    font-family: var(--mono);
    font-size: 10px;
    color: #57634b;
    pointer-events: none;
  }
  .con-motion {
    position: absolute;
    right: 0;
    bottom: 8px;
    border: 1px solid var(--rule);
    background: var(--cream);
    font-family: var(--mono);
    font-size: 10px;
    padding: 8px 10px;
    display: flex;
    gap: 10px;
    align-items: center;
    z-index: 2;
  }
  .con-controls {
    border-top: 1px solid var(--rule);
    padding: 23px 0;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
  }
  .con-invitation {
    display: flex;
    gap: 17px;
    align-items: center;
  }
  .con-pointer {
    font-size: 38px;
    color: var(--green);
    line-height: 1;
  }
  .con-invitation strong {
    font-weight: 500;
    font-size: 15px;
  }
  .con-invitation p {
    font-size: 12px;
    color: #58604e;
    margin-top: 5px;
    min-height: 20px;
    max-width: 470px;
  }
  .con-party {
    background: var(--green);
    color: var(--cream);
    border: 1px solid var(--green);
    font-size: 13px;
    padding: 15px 18px;
    display: flex;
    gap: 15px;
    align-items: center;
    white-space: nowrap;
    box-shadow: 3px 3px 0 #c4d193;
    transition:
      transform 0.15s,
      box-shadow 0.15s;
  }
  .con-party:hover {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 #c4d193;
  }
  .con-party span:first-child {
    font-size: 20px;
    color: var(--yellow);
  }
  .con-party:disabled,
  .con-local:disabled {
    opacity: 0.5;
  }
  .con-locals {
    display: flex;
    align-items: center;
    gap: 9px;
    padding-bottom: 24px;
    flex-wrap: wrap;
  }
  .con-local {
    display: flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    border: 1px solid #ccd0bc;
    padding: 9px 12px;
    font-size: 11px;
    transition: background 0.15s;
  }
  .con-local:hover,
  .con-local[aria-pressed="true"] {
    background: #e7edda;
    border-color: var(--green);
  }
  .local-dot {
    width: 8px;
    height: 8px;
    background: var(--local-color);
    box-shadow: 2px 2px 0 #00140022;
  }
  .local-check {
    color: #7a836e;
    margin-left: 7px;
  }
  .con-local[data-met="true"] .local-check {
    color: var(--green);
  }
  .con-progress {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 10px;
    color: #5c664e;
  }
  .con-bottom {
    border-top: 1px solid var(--rule);
    padding-top: 18px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 11px;
  }
  .con-bottom > a {
    font-weight: 500;
  }
  .con-bottom > a span {
    margin-left: 12px;
  }
  .con-tooltip {
    position: absolute;
    z-index: 4;
    background: var(--ink);
    color: var(--cream);
    font: 11px var(--mono);
    padding: 8px 10px;
    pointer-events: none;
    white-space: nowrap;
    transform: translate(-50%, -100%);
    box-shadow: 3px 3px 0 #00140025;
  }
  .con-bubbles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 3;
  }
  .con-bubbles :global(.con-bubble) {
    position: absolute;
    transform: translate(-50%, -100%);
    background: var(--cream);
    border: 1px solid var(--ink);
    box-shadow: 3px 3px 0 #00140022;
    padding: 7px 10px;
    font: 10px var(--mono);
    white-space: nowrap;
  }
  .con-bubbles :global(.con-bubble::after) {
    content: "";
    position: absolute;
    bottom: -6px;
    left: 50%;
    width: 8px;
    height: 8px;
    background: var(--cream);
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    transform: rotate(45deg);
  }
  @media (min-width: 1450px) {
    .con-world {
      height: 490px;
    }
  }
  @media (max-width: 900px) {
    .con-world {
      height: 430px;
    }
    .con-heading h1 {
      font-size: 17.6vw;
    }
    .con-spark {
      margin-left: 0.15em;
    }
    .con-progress {
      width: 100%;
      margin: 4px 0 0;
    }
    .con-bottom > span:nth-child(2) {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .con-heading-top {
      font-size: 10px;
      padding-top: 16px;
    }
    .con-heading-top > span:last-child {
      max-width: 135px;
      text-align: right;
      line-height: 1.5;
    }
    .con-heading-top b {
      margin: 0 3px;
    }
    .con-heading h1 {
      font-size: 19vw;
      margin-top: 20px;
      line-height: 1;
    }
    .con-spark {
      font-size: 0.28em;
      margin-left: 0.06em;
    }
    .con-intro {
      align-items: flex-start;
      margin-top: 12px;
    }
    .con-intro p {
      font-size: 12px;
      max-width: 180px;
    }
    .con-intro .button {
      font-size: 11px;
      gap: 12px;
      padding: 10px 12px;
    }
    .con-world {
      height: 310px;
      margin-inline: -20px;
      margin-top: 15px;
    }
    .con-world-label {
      left: 20px;
      top: 6px;
      font-size: 9px;
    }
    .con-world-note {
      left: 20px;
      font-size: 9px;
      max-width: 245px;
    }
    .con-motion {
      right: 20px;
      font-size: 9px;
    }
    .con-controls {
      align-items: flex-start;
      flex-direction: column;
      padding: 18px 0;
      gap: 15px;
    }
    .con-invitation p {
      font-size: 11px;
      max-width: 300px;
    }
    .con-party {
      align-self: stretch;
      justify-content: center;
      padding: 12px 16px;
    }
    .con-locals {
      gap: 7px;
    }
    .con-local {
      padding: 9px 10px;
      flex: 1 0 28%;
      justify-content: space-between;
    }
    .con-progress {
      font-size: 9px;
    }
    .con-bottom {
      font-size: 10px;
    }
    .con-bottom > span:nth-child(3) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .con-party,
    .con-local {
      transition: none;
    }
  }
</style>
