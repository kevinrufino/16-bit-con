---
import "./global.css";
const {
  title = "16-Bit Con — Small pixels. Big ideas.",
  description = "A day for the beautifully curious. Retro tech, fresh perspectives, and a little friendly competition. October 24, 2026. Brooklyn, NY.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fffaeb" />
    <title>{title}</title>
    <link rel="icon" href="/images/vega-logo.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/PPMondwest-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {import.meta.env.DEV && (
      <script
        is:inline
        src="https://mcp.figma.com/mcp/html-to-design/capture.js"
        async
      ></script>
    )}
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <slot />
  </body>
</html>
