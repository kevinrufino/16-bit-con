---
import { event, sessions } from "../../design/event";
import SessionArt from "../../components/SessionArt.astro";
---

<section id="schedule" class="scroll-schedule" aria-labelledby="lineup-title">
  <div class="schedule-summary wrap">
    <span class="section-marker mono">02 / THE LINEUP</span>
    <h2 id="lineup-title">
      Three stops.
      <br />
      No filler.
    </h2>
    <p>
      {event.date} · {event.location}
    </p>
    <nav class="agenda" aria-label="Jump to a session">
      {sessions.map((session, i) => (
        <a href={`#schedule-event-${i}`}>
          <span class="mono">{session.time}</span>
          <strong>{session.title}</strong>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
    <p class="schedule-help">
      Scroll through one session at a time, or choose a time above.
    </p>
  </div>
  <div class="schedule-stories">
    {sessions.map((session, i) => (
      <article
        id={`schedule-event-${i}`}
        class={`schedule-stop tone-${session.tone}`}
        data-stop={i}
        data-pattern={session.pattern}
        aria-labelledby={`session-title-${i}`}
        tabindex="-1"
      >
        <div class="wrap session-inner">
          <div class="session-meta mono">
            <span>{String(i + 1).padStart(2, "0")} / 03</span>
            <span>
              {session.time} · {session.type}
            </span>
            <span>{session.place}</span>
          </div>
          <div class="session-body">
            <div class="session-visual">
              <SessionArt kind={session.scene} />
              <span class="art-caption mono">{session.place} / 16-Bit Con</span>
            </div>
            <div class="session-copy">
              <span class="stop-time">{session.time}</span>
              <h3 id={`session-title-${i}`} data-pixel-reveal={session.pattern}>
                {session.title}
              </h3>
              <p>{session.detail}</p>
            </div>
          </div>
          <nav
            class="session-controls"
            aria-label={`Navigation for ${session.title}`}
          >
            <a
              href={i ? `#schedule-event-${i - 1}` : "#schedule"}
              data-session-nav
            >
              <span aria-hidden="true">↑</span>{" "}
              {i ? "Previous session" : "View agenda"}
            </a>
            <div class="session-dots" aria-label={`Session ${i + 1} of 3`}>
              {sessions.map((_, j) => (
                <a
                  href={`#schedule-event-${j}`}
                  data-session-nav
                  aria-label={`Go to session ${j + 1}`}
                  aria-current={i === j ? "step" : undefined}
                >
                  {String(j + 1).padStart(2, "0")}
                </a>
              ))}
            </div>
            <a
              href={i < 2 ? `#schedule-event-${i + 1}` : "#register"}
              data-session-nav
            >
              {i < 2 ? "Next session" : "Find Booth 630"}{" "}
              <span aria-hidden="true">↓</span>
            </a>
          </nav>
        </div>
      </article>
    ))}
  </div>
  <span class="sr-only" role="status" id="schedule-status"></span>
</section>
<script>
  import "../../scripts/draft-guided-schedule";
</script>
<style>
  .scroll-schedule {
    background: var(--color-surface);
  }
  .schedule-summary {
    padding-block: var(--space-20);
  }
  .schedule-summary h2 {
    font-size: var(--text-section);
    margin-block: var(--space-6);
  }
  .schedule-summary > p {
    font-size: var(--text-sm);
  }
  .agenda {
    display: grid;
    margin-top: var(--space-10);
    border-top: 1px solid var(--color-border-strong);
  }
  .agenda a {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    align-items: center;
    gap: var(--space-6);
    padding-block: var(--space-5);
    min-height: var(--target-min);
    border-bottom: 1px solid var(--color-border);
  }
  .agenda strong {
    font-weight: 400;
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }
  .schedule-help {
    margin-top: var(--space-6);
    color: var(--color-text-muted);
  }
  .schedule-stop {
    min-height: 100svh;
    position: relative;
    background: var(--color-surface);
    scroll-margin-top: 0;
    outline-offset: -6px;
  }
  .tone-day {
    background: var(--color-surface);
    --session-accent: var(--color-heading);
  }
  .tone-leaf {
    background: var(--color-heading);
    color: var(--color-inverse);
    --session-accent: var(--color-accent);
  }
  .tone-night {
    background: var(--color-dark);
    color: var(--color-inverse);
    --session-accent: var(--color-accent);
  }
  .session-inner {
    min-height: 100svh;
    padding-block: var(--space-8);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-8);
  }
  .session-meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: var(--text-xs);
  }
  .session-meta > span:first-child {
    color: var(--session-accent);
  }
  .session-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-20);
    align-items: center;
    padding-block: var(--space-8);
  }
  .session-visual {
    max-width: 460px;
    width: 100%;
    margin: auto;
    position: relative;
  }
  .session-visual :global(svg) {
    aspect-ratio: 1;
  }
  .art-caption {
    display: block;
    margin-top: var(--space-4);
    text-align: center;
  }
  .stop-time {
    font: var(--text-lg) var(--font-mono);
    color: var(--session-accent);
  }
  .session-copy h3 {
    position: relative;
    font: var(--text-session)/var(--leading-heading) var(--font-display);
    letter-spacing: var(--tracking-heading);
    margin-block: var(--space-6);
    text-wrap: balance;
  }
  .session-copy p {
    max-width: 42ch;
    font-size: var(--text-base);
  }
  .session-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    border-top: 1px solid currentColor;
    padding-top: var(--space-4);
    font-size: var(--text-sm);
  }
  .session-controls a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--target-min);
  }
  .session-dots {
    display: flex;
    gap: var(--space-2);
  }
  .session-dots a {
    justify-content: center;
    min-width: var(--target-min);
    border: 1px solid transparent;
    font: var(--text-xs) var(--font-mono);
  }
  .session-dots a[aria-current] {
    border-color: currentColor;
    background: var(--session-accent);
    color: var(--color-surface);
  }
  .tone-leaf .session-dots a[aria-current],
  .tone-night .session-dots a[aria-current] {
    color: var(--color-text);
  }
  @media (hover: hover) {
    .agenda a:hover {
      background: var(--color-accent);
    }
    .session-controls a:hover {
      text-decoration: underline;
      text-underline-offset: 5px;
    }
  }
  @media (max-width: 760px) {
    .agenda a {
      grid-template-columns: 90px 1fr auto;
      gap: var(--space-3);
    }
    .session-inner {
      padding-block: var(--space-6);
      gap: var(--space-4);
    }
    .session-meta {
      font-size: var(--text-micro);
    }
    .session-body {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      padding: 0;
    }
    .session-visual {
      width: min(46svh, 250px);
    }
    .art-caption {
      display: none;
    }
    .session-copy h3 {
      font-size: var(--text-session-mobile);
      margin-block: var(--space-3);
    }
    .session-copy p {
      font-size: var(--text-sm);
    }
    .stop-time {
      font-size: var(--text-sm);
    }
    .session-controls {
      font-size: var(--text-xs);
      flex-wrap: wrap;
    }
    .session-dots {
      order: 3;
      width: 100%;
      justify-content: center;
    }
  }
  @media (prefers-reduced-motion: reduce), (max-height: 620px) {
    .schedule-stop,
    .session-inner {
      min-height: auto;
    }
    .session-inner {
      padding-block: var(--space-12);
    }
  }
</style>
