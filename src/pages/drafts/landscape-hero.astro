---
import Layout from "../../layouts/Layout.astro";
import ConventionHero from "../../archive/landscape-hero/ConventionHero.astro";
import PassStudio from "../../components/PassStudio.astro";
import ScrollSchedule from "../../components/ScrollSchedule.astro";
---

<Layout title="Landscape hero — 16-Bit Con drafts">
  <aside class="archive-banner">
    <span>ARCHIVED / LANDSCAPE HERO</span>
    <a href="/drafts">All drafts ↗</a>
    <a href="/">Current site ↗</a>
  </aside>
  <main id="main">
    <div class="hero-curtain">
      <header class="site-header wrap">
        <a class="brand" href="/" aria-label="Vega, 16-Bit Con home">
          <img src="/images/vega-logo.svg" alt="Vega" width="108" height="35" />
          <span class="brand-divider"></span>
          <span class="mono brand-event">PRESENTS 16-BIT CON</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="#about">The experience</a>
          <a href="#schedule">The lineup</a>
          <a href="#play">Pixel playground</a>
        </nav>
        <a class="button small" href="#register">
          Get your pass <span aria-hidden="true">↗</span>
        </a>
      </header>
      <ConventionHero />
    </div>
    <div class="schedule-curtain">
      <section id="about" class="about wrap section">
        <div class="section-marker mono">01 / THE EXPERIENCE</div>
        <div class="about-grid">
          <h2>
            A little nostalgia.
            <br />A lot of possibility.
          </h2>
          <div>
            <p class="large-copy">
              Remember when technology felt like an invitation to play? We’re
              bringing that feeling back.
            </p>
            <p>
              Meet the builders, tinkerers, and curious minds turning
              yesterday’s inspiration into tomorrow’s ideas. Come for the talks.
              Stay for the unexpected connections.
            </p>
            <div class="stats">
              <div>
                <strong>01</strong>
                <span>
                  day to disconnect
                  <br />
                  and reconnect
                </span>
              </div>
              <div>
                <strong>07</strong>
                <span>
                  sessions to spark
                  <br />
                  something new
                </span>
              </div>
              <div>
                <strong>∞</strong>
                <span>
                  reasons to
                  <br />
                  press start
                </span>
              </div>
            </div>
          </div>
        </div>
      </section>
      <ScrollSchedule />
    </div>
    <div class="footer-curtain">
      <canvas class="pass-aura" aria-hidden="true"></canvas>
      <span id="register"></span>
      <PassStudio />
      <footer class="wrap">
        <a href="https://vega.io" aria-label="Visit Vega">
          <img src="/images/vega-logo.svg" alt="Vega" width="96" height="32" />
        </a>
        <span>Built for the love of what’s next.</span>
        <a href="/drafts">Behind the pixels ↗</a>
        <span class="mono">A FICTIONAL EVENT. A REAL GOOD IDEA.</span>
      </footer>
    </div>
  </main>
  <dialog id="pass-dialog" aria-labelledby="pass-title">
    <div class="ticket-modal-content">
      <button class="close-dialog" aria-label="Close pass dialog" type="button">
        ×
      </button>
      <span class="mono" id="modal-edition">
        16-BIT CON / YOUR PASS
      </span>
      <h2 id="pass-title">Make it yours.</h2>
      <p>
        This is a fictional convention. Create a souvenir pass to keep the good
        pixels going.
      </p>
      <form id="pass-form">
        <label for="player-name">Your player name</label>
        <input
          id="player-name"
          name="player"
          autocomplete="nickname"
          placeholder="Your name or alias"
          maxlength="30"
          required
        />
        <button class="button dark" type="submit">
          Create my souvenir pass ↗
        </button>
      </form>
      <div id="pass-result" hidden>
        <p id="pass-message" role="status"></p>
        <button id="download-pass" class="button dark" type="button">
          Download your pass ↓
        </button>
      </div>
    </div>
  </dialog>
</Layout>

<script>
  import "../../scripts/curtains";
</script>
<style is:global>
  .archive-banner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    padding: 14px 24px;
    background: var(--ink);
    color: var(--cream);
    font: 12px var(--mono);
  }
  .archive-banner a {
    color: var(--yellow);
  }
  .hero-curtain {
    position: sticky;
    top: min(0px, calc(100svh - var(--panel-height, 100svh)));
    z-index: 0;
    min-height: 100svh;
    background: var(--cream);
  }
  .hero-curtain .con-layout {
    min-height: calc(100svh - 93px);
  }
  .schedule-curtain {
    position: relative;
    z-index: 2;
    background: var(--cream);
    box-shadow:
      0 -12px 30px #0014000c,
      0 12px 30px #0014000c;
  }
  .footer-curtain {
    position: sticky;
    bottom: min(0px, calc(100svh - var(--panel-height, 100svh)));
    z-index: 1;
    isolation: isolate;
    min-height: 100svh;
    background: var(--cream);
  }
  .footer-curtain > .pass-aura {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    image-rendering: pixelated;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-curtain,
    .footer-curtain {
      position: relative;
      top: auto;
      bottom: auto;
    }
  }
</style>
